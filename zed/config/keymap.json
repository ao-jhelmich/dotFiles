// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-t": "project_symbols::Toggle"
    }
  },
  {
    "context": "DebugPanel",
    "unbind": {
      "cmd-t": "debugger::ToggleThreadPicker"
    }
  },
  {
    "context": "KeymapEditor",
    "unbind": {
      "cmd-t": "keymap_editor::ShowMatchingKeybinds"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-t": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-d": "pane::SplitRight",
      "shift-alt-d": "pane::SplitDown",
      "cmd-e": "project_panel::ToggleFocus",
      "cmd-shift-e": "workspace::ToggleRightDock",
      "cmd-[": "pane::GoBack",
      "cmd-]": "pane::GoForward",
      "cmd-k cmd-k": "workspace::ToggleZoom",
      "cmd-k cmd-g": ["task::Spawn", { "task_name": "generate php namespace" }],
      "cmd-k cmd-d": ["task::Spawn", { "task_name": "duplicate current file" }],
      "ctrl-cmd-left": "workspace::ActivatePaneRight",
      "ctrl-cmd-right": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-b": "workspace::ToggleLeftDock",
      "cmd-\\": "pane::SplitRight"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-shift-g": "search::SelectPreviousMatch",
      "alt-cmd-t": "pane::CloseOtherItems"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-[": "editor::Outdent",
      "cmd-]": "editor::Indent",
      "cmd-\\": "pane::SplitRight"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "cmd-e": "buffer_search::UseSelectionForFind",
      "ctrl--": "pane::GoBack"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "unbind": {
      "ctrl-cmd-right": "editor::AcceptNextWordEditPrediction"
    }
  },
  {
    "context": "Editor && extension == php",
    "bindings": {
      "ctrl-alt-i": "editor::ToggleCodeActions",
      "ctrl-alt-e": ["task::Spawn", { "task_name": "php expand class" }]
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "backspace": ["project_panel::Trash", { "skip_prompt": true }],
      "delete": ["project_panel::Trash", { "skip_prompt": true }]
    }
  }
]
